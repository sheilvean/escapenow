    <ProjectReference Include="../EscapeNow.Infrastructure/EscapeNow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration test project drives this host through WebApplicationFactory. -->
    <InternalsVisibleTo Include="EscapeNow.IntegrationTests" />
  </ItemGroup>

</Project>
