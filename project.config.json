{
  "$schema": "./project.config.schema.json",
  "solutionName": "EscapeNow",
  "rootNamespace": "EscapeNow",
  "paths": {
    "solutionFile": "EscapeNow.slnx",
    "src": "src",
    "tests": "tests",
    "frontend": "frontend"
  },
  "architecture": {
    "profile": "layered"
  },
  "documentation": {
    "language": "en"
  },
  "integrations": {
    "database": "none",
    "deployment": "none"
  },
  "openspec": {
    "changePolicy": {
      "default": "standard",
      "allowTrivial": true
    },
    "archiveGate": {
      "enabled": true,
      "scope": "repository",
      "requireZeroActiveChanges": true
    }
  }
}
