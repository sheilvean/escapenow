<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- These libraries exist to violate the architecture rules on purpose. Failing their
         build on the very warnings they are designed to provoke would make the negative
         tests unrunnable, so the warning policy is relaxed here and only here. The
         architecture tests are what judges these files. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <NoWarn>$(NoWarn);CS1591;CA1050;IDE0130</NoWarn>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
